---
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { href: '/', label: 'Início' },
  { href: '/archive', label: 'Arquivo' },
  { href: '/tags', label: 'Tags' },
  { href: '/about', label: 'Sobre' },
];

const path = '/' + Astro.url.pathname.replace(/^\/|\/$/g, '');
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="brand" aria-label="valderson, início">
      <span class="brand__paw" aria-hidden="true">🐾</span>
      <span>valderson<span class="brand__accent">.</span></span>
    </a>

    <nav class="nav" aria-label="Navegação principal">
      {
        nav.map((item) => (
          <a
            class="nav__link"
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>
