---
// Light/dark toggle. State lives on <html data-theme>, persisted to
// localStorage, and pre-applied in BaseHead to avoid a flash.
---

<button class="theme-toggle" type="button" aria-label="Alternar tema claro/escuro" title="Alternar tema">
  <svg class="moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
  <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
</button>

<script>
  // Bind once on the document so a single listener survives view transitions.
  if (!(window as any).__themeToggleBound) {
    (window as any).__themeToggleBound = true;
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement)?.closest('.theme-toggle');
      if (!btn) return;
      const root = document.documentElement;
      const current =
        root.getAttribute('data-theme') ||
        (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const next = current === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch (err) {}
    });
  }
</script>
