---
import { localePath, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const feed = lang === 'en' ? '/en/rss.xml' : '/rss.xml';
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <p>
      <span aria-hidden="true">🐾</span>
      &nbsp;valderson &copy; {year}
    </p>
    <nav class="site-footer__social" aria-label={t['a11y.social']}>
      <a href="https://github.com/valdersonjr" target="_blank" rel="me noopener">GitHub</a>
      <a href="https://www.linkedin.com/in/valdersonjr/" target="_blank" rel="me noopener">LinkedIn</a>
      <a href={feed}>RSS</a>
    </nav>
  </div>
</footer>
