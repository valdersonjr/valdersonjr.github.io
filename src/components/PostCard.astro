---
import type { CollectionEntry } from 'astro:content';
import { formatDateShort, readingTime, excerpt } from '../utils';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const body = post.body ?? '';
const summary = post.data.description ?? excerpt(body);
---

<article class="post-card">
  <div class="post-card__meta">
    <time class="post-card__date" datetime={post.data.date.toISOString()}>
      {formatDateShort(post.data.date)}
    </time>
    <span class="post-card__read">{readingTime(body)}</span>
  </div>
  <div>
    <h2 class="post-card__title"><a href={`/${post.id}`}>{post.data.title}</a></h2>
    <p class="post-card__excerpt">{summary}</p>
  </div>
</article>
