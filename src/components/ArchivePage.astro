---
// Archive shared by `/archive` and `/en/archive`.
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDayMonth, getYear } from '../utils';
import { getPosts, postPath, type Post } from '../posts';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = await getPosts(lang);

const byYear = new Map<number, Post[]>();
for (const post of posts) {
  const year = getYear(post.data.date);
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<BaseLayout title={t['archive.title']} description={t['archive.description']}>
  <section class="wrap page-intro">
    <span class="page-intro__eyebrow">{t['archive.eyebrow']}</span>
    <h1 class="page-intro__title">{t['archive.heading']}</h1>
    <p class="page-intro__lead">{t['archive.count'](posts.length)}</p>
  </section>

  <section class="wrap--content">
    {
      years.map((year) => (
        <div class="archive-year">
          <div class="archive-year__label">{year}</div>
          <ul class="archive-list">
            {byYear.get(year)!.map((post) => (
              <li class="archive-row">
                <time datetime={post.data.date.toISOString()}>
                  {formatDayMonth(post.data.date, lang)}
                </time>
                <a href={postPath(post.id, lang)}>{post.data.title}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</BaseLayout>
