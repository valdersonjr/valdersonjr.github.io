---
import PostPage from '../../components/PostPage.astro';
import { getPosts, getAlternate } from '../../posts';

export async function getStaticPaths() {
  const posts = await getPosts('en');

  return Promise.all(
    posts.map(async (post, i) => ({
      params: { slug: post.id },
      props: {
        post,
        newer: posts[i - 1] ?? null, // more recent (list is newest-first)
        older: posts[i + 1] ?? null, // older
        alternate: await getAlternate(post, 'en'),
      },
    })),
  );
}

const { post, newer, older, alternate } = Astro.props;
---

<PostPage post={post} newer={newer} older={older} lang="en" alternate={alternate} />
