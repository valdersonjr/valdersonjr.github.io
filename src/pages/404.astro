---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página não encontrada">
  <section class="wrap notfound">
    <div class="notfound__code">404</div>
    <h1 style="font-size: var(--step-2); margin-bottom: var(--space-sm);">Esse gatinho fugiu 🐾</h1>
    <p class="lead" style="margin-bottom: var(--space-lg);">
      A página que você procurou não existe, ou mudou de lugar.
    </p>
    <a class="tag" href="/">← Voltar pro início</a>
  </section>
</BaseLayout>
