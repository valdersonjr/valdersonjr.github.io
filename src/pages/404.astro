---
import BaseLayout from '../layouts/BaseLayout.astro';

// GitHub Pages serves this single file for every missing path, including the
// ones under /en, so it answers in both languages instead of guessing.
---

<BaseLayout title="Página não encontrada | Page not found" altHref={null}>
  <section class="wrap notfound">
    <div class="notfound__code">404</div>
    <h1 style="font-size: var(--step-2); margin-bottom: var(--space-sm);">Esse gatinho fugiu 🐾</h1>
    <p class="lead" style="margin-bottom: var(--space-lg);">
      A página que você procurou não existe, ou mudou de lugar.
    </p>
    <a class="tag" href="/">← Voltar pro início</a>

    <p class="lead" style="margin-top: var(--space-xl); margin-bottom: var(--space-lg);" lang="en">
      The page you were looking for does not exist, or has moved.
    </p>
    <a class="tag" href="/en" lang="en">← Back home</a>
  </section>
</BaseLayout>
