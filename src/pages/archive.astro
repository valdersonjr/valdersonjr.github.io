---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDayMonth, getYear } from '../utils';

const posts = (await getCollection('posts', ({ data }) => data.published !== false)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const byYear = new Map<number, CollectionEntry<'posts'>[]>();
for (const post of posts) {
  const year = getYear(post.data.date);
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<BaseLayout title="Arquivo" description="Todos os posts, organizados por ano.">
  <section class="wrap page-intro">
    <span class="page-intro__eyebrow">arquivo</span>
    <h1 class="page-intro__title">Tudo, por ano.</h1>
    <p class="page-intro__lead">{posts.length} textos até agora.</p>
  </section>

  <section class="wrap--content">
    {
      years.map((year) => (
        <div class="archive-year">
          <div class="archive-year__label">{year}</div>
          <ul class="archive-list">
            {byYear.get(year)!.map((post) => (
              <li class="archive-row">
                <time datetime={post.data.date.toISOString()}>{formatDayMonth(post.data.date)}</time>
                <a href={`/${post.id}`}>{post.data.title}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</BaseLayout>
