---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, readingTime, excerpt } from '../utils';

export async function getStaticPaths() {
  const posts = (await getCollection('posts', ({ data }) => data.published !== false)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );

  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: posts[i - 1] ?? null, // more recent (list is newest-first)
      older: posts[i + 1] ?? null, // older
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const body = post.body ?? '';
const description = post.data.description ?? excerpt(body);
---

<BaseLayout title={post.data.title} description={description} article={true}>
  <article>
    <header class="wrap--content post-header">
      <h1 class="post-header__title">{post.data.title}</h1>
      <div class="post-header__meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span class="dot" aria-hidden="true"></span>
        <span>{readingTime(body)}</span>
        {
          post.data.tags.length > 0 && (
            <>
              <span class="dot" aria-hidden="true" />
              <span class="tags">
                {post.data.tags.map((tag) => (
                  <a class="tag" href={`/tags#${tag.toLowerCase()}`}>
                    {tag}
                  </a>
                ))}
              </span>
            </>
          )
        }
      </div>
    </header>

    <div class="wrap--content prose">
      <Content />
    </div>

    <nav class="wrap--content post-nav" aria-label="Outros posts">
      {
        older ? (
          <a class="post-nav__link post-nav__link--prev" href={`/${older.id}`}>
            <span class="post-nav__kicker">← Mais antigo</span>
            <span class="post-nav__title">{older.data.title}</span>
          </a>
        ) : (
          <span aria-hidden="true" />
        )
      }
      {
        newer ? (
          <a class="post-nav__link post-nav__link--next" href={`/${newer.id}`}>
            <span class="post-nav__kicker">Mais recente →</span>
            <span class="post-nav__title">{newer.data.title}</span>
          </a>
        ) : (
          <span aria-hidden="true" />
        )
      }
    </nav>

    <section class="wrap--content" style="margin-top: var(--space-xl);">
      <div id="disqus_thread"></div>
    </section>
  </article>
</BaseLayout>

<script>
  // Lazy-load Disqus only when the comments area is near the viewport, so it
  // never costs readers who don't scroll that far.
  const mount = document.getElementById('disqus_thread');
  if (mount && !(window as any).__disqusLoaded) {
    const load = () => {
      if ((window as any).__disqusLoaded) return;
      (window as any).__disqusLoaded = true;
      const d = document;
      const s = d.createElement('script');
      s.src = 'https://valdersonjr.disqus.com/embed.js';
      s.setAttribute('data-timestamp', String(+new Date()));
      (d.head || d.body).appendChild(s);
    };
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          load();
          io.disconnect();
        }
      },
      { rootMargin: '400px' },
    );
    io.observe(mount);
  }
</script>
