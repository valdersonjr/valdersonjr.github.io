---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDayMonth } from '../utils';

const posts = (await getCollection('posts', ({ data }) => data.published !== false)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const tagMap = new Map<string, CollectionEntry<'posts'>[]>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    if (!tagMap.has(tag)) tagMap.set(tag, []);
    tagMap.get(tag)!.push(post);
  }
}
const tags = [...tagMap.keys()].sort((a, b) => a.localeCompare(b, 'pt'));
---

<BaseLayout title="Tags" description="Posts organizados por tema.">
  <section class="wrap page-intro">
    <span class="page-intro__eyebrow">tags</span>
    <h1 class="page-intro__title">Por tema.</h1>
    <div class="tags" style="margin-top: var(--space-md);">
      {tags.map((tag) => <a class="tag" href={`#${tag.toLowerCase()}`}>{tag} · {tagMap.get(tag)!.length}</a>)}
    </div>
  </section>

  <section class="wrap--content">
    {
      tags.map((tag) => (
        <div class="archive-year" id={tag.toLowerCase()}>
          <div class="archive-year__label">#{tag}</div>
          <ul class="archive-list">
            {tagMap.get(tag)!.map((post) => (
              <li class="archive-row">
                <time datetime={post.data.date.toISOString()}>{formatDayMonth(post.data.date)}</time>
                <a href={`/${post.id}`}>{post.data.title}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</BaseLayout>
